# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://yg-services.ch

# Adresse qui reçoit les demandes envoyées depuis les formulaires
CONTACT_INBOX=

# Envoi des e-mails (optionnel).
# Si RESEND_API_KEY est vide, les demandes sont uniquement journalisées côté serveur
# et le formulaire reste fonctionnel pour le visiteur.
RESEND_API_KEY=
RESEND_FROM=

# Vérification Google Search Console (balise meta), optionnel
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

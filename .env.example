# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://yg-services.ch

# Adresse qui reçoit les demandes du formulaire.
# Si cette variable est vide, l'adresse de src/config/site.ts est utilisée.
CONTACT_INBOX=info@yg-services.ch

# --- Envoi des e-mails via la messagerie Infomaniak ---
# Tant que SMTP_HOST est vide, les demandes sont uniquement journalisées côté
# serveur : le formulaire reste fonctionnel pour le visiteur, mais aucun e-mail
# n'est envoyé. À renseigner avant la mise en ligne.
#
# SMTP_PASSWORD est un secret : ne jamais le committer, le saisir uniquement
# dans les variables d'environnement de Netlify.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=info@yg-services.ch
SMTP_PASSWORD=
# Expéditeur affiché. Doit appartenir au domaine authentifié, sinon le message
# est rejeté. Laisser vide pour réutiliser SMTP_USER.
SMTP_FROM=info@yg-services.ch

# Vérification Google Search Console (balise meta), optionnel
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
